# --- Assets con copyright (PROHIBIDOS en Git) ---
*.kpf
*.exe
*.dll
*.z64
# Datos del juego aportados por el usuario: nunca se versionan (solo se conserva .gitkeep)
android/app/src/main/assets/game_data/*
!android/app/src/main/assets/game_data/.gitkeep

# --- Artefactos de compilación Android/NDK ---
*.apk
*.aab
build/
.cxx/
build-host/
.externalNativeBuild/
.gradle/
local.properties
*.so
*.o

# --- Firma (nunca versionar) ---
*.jks
*.keystore

# --- Python (tools/, tests/) ---
__pycache__/
*.py[cod]

# --- IDE / sistema ---
.idea/
.vscode/
*.iml
.DS_Store
*.log
.env
.claude/settings.local.json
